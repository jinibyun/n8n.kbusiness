                      "id":  "70c2e385-40c9-4906-873d-a7a7daf3e6ed",
                      "name":  "USD/CAD Threshold Check",
                      "type":  "n8n-nodes-base.if",
                      "typeVersion":  2.3,
                      "position":  [
                                       448,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const rawRate = Number($json.rates?.CAD ?? $json.currentRate ?? 0);\nconst alertTime = $now.setZone(\u0027America/Toronto\u0027).toFormat(\u0027yyyy-MM-dd HH:mm:ss\u0027);\nconst isValidRate = Number.isFinite(rawRate) \u0026\u0026 rawRate \u003e 0;\nconst currentRate = isValidRate ? rawRate : null;\nconst rateText = isValidRate ? rawRate.toFixed(4) : \u0027조회 실패\u0027;\nconst direction = rawRate \u003e= 1.38 ? \u0027고환율 통제\u0027 : \u0027저환율 통제\u0027;\n\nconst blocks = [\n  {\n    type: \u0027header\u0027,\n    text: {\n      type: \u0027plain_text\u0027,\n      text: \u0027🚨 [환율 변동성 경보] USD/CAD 임계값 돌파\u0027,\n      emoji: true,\n    },\n  },\n  {\n    type: \u0027section\u0027,\n    text: {\n      type: \u0027mrkdwn\u0027,\n      text: \u0027*현재 환율:* \u0027 + rateText + \u0027 CAD\\n*기준 시간:* \u0027 + alertTime + \u0027\\n*판정:* \u0027 + direction,\n    },\n  },\n];\n\nreturn [\n  {\n    json: {\n      currentRate,\n      alertTime,\n      direction,\n      text: \u0027USD/CAD 임계값 경보 - \u0027 + rateText + \u0027 CAD\u0027,\n      blocksUi: JSON.stringify(blocks),\n    },\n  },\n];"
                                     },
