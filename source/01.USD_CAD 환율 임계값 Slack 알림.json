  "id": "WZfdHSsnjuQan1Ag",
  "name": "USD/CAD 환율 임계값 Slack 알림",
  "description": "매일 9시~18시 30분 간격으로 USD/CAD 환율을 조회해 지정 임계값을 벗어나면 Slack으로 경보를 발송합니다.",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "98c52c38-cd57-49d5-b730-0acc07331383",
      "name": "USD/CAD Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 9-18 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "98b7f50d-cebb-4bfb-9f7d-d4b130fc83a3",
      "name": "Fetch USD/CAD Rate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.exchangerate-api.com/v6/latest/USD",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "response": {
          "response": {
            "responseFormat": "json"
          }
        }
      }
    },
    {
      "id": "70c2e385-40c9-4906-873d-a7a7daf3e6ed",
      "name": "USD/CAD Threshold Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.rates?.CAD ?? 0 }}",
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              },
              "rightValue": 1.38
            },
            {
              "leftValue": "={{ $json.rates?.CAD ?? 0 }}",
              "operator": {
                "type": "number",
                "operation": "smallerEqual"
              },
              "rightValue": 1.32
            }
          ],
          "combinator": "or"
        }
      }
    },
    {
      "id": "5d296888-f5ed-4047-8b87-677b99e8465d",
      "name": "Format Slack Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rawRate = Number($json.rates?.CAD ?? $json.currentRate ?? 0);\nconst alertTime = $now.setZone('America/Toronto').toFormat('yyyy-MM-dd HH:mm:ss');\nconst isValidRate = Number.isFinite(rawRate) && rawRate > 0;\nconst currentRate = isValidRate ? rawRate : null;\nconst rateText = isValidRate ? rawRate.toFixed(4) : '조회 실패';\nconst direction = rawRate >= 1.38 ? '고환율 통제' : '저환율 통제';\n\nconst blocks = [\n  {\n    type: 'header',\n    text: {\n      type: 'plain_text',\n      text: '🚨 [환율 변동성 경보] USD/CAD 임계값 돌파',\n      emoji: true,\n    },\n  },\n  {\n    type: 'section',\n    text: {\n      type: 'mrkdwn',\n      text: '*현재 환율:* ' + rateText + ' CAD\\n*기준 시간:* ' + alertTime + '\\n*판정:* ' + direction,\n    },\n  },\n];\n\nreturn [\n  {\n    json: {\n      currentRate,\n      alertTime,\n      direction,\n      text: 'USD/CAD 임계값 경보 - ' + rateText + ' CAD',\n      blocksUi: JSON.stringify(blocks),\n    },\n  },\n];"
      }
    },
    {
      "id": "48a3c6a6-96ff-44e6-8f5f-df30a5457285",
      "name": "Send Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.5,
      "position": [
        896,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#fx-alerts"
        },
        "messageType": "block",
        "text": "={{ $json.text ?? \"USD/CAD 임계값 경보\" }}",
        "blocksUi": "={{ $json.blocksUi ?? \"[]\" }}"
      },
      "webhookId": "87f8af32-8771-4448-92c6-8843c2927f6d"
    }
  ],
  "connections": {
    "USD/CAD Schedule": {
      "main": [
