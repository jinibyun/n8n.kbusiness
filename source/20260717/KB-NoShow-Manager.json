                  {
                      "id":  "d15ed5df-94d1-40bf-8c2f-873c9172d88d",
                      "name":  "액션 분류 (remind/noshow)",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       448,
                                       320
                                   ],
                      "parameters":  {
                                         "jsCode":  "const now = new Date();\nconst result = [];\n\nfor (const item of $input.all()) {\n  const rec = item.json;\n  const aptTime = new Date(rec.appointment_time);\n  const reminderSent = !!rec.reminder_sent;\n  const noShowCount = Number(rec.no_show_count ?? 0);\n  const diffHours = (aptTime - now) / (1000 * 60 * 60);\n\n  let action = \u0027skip\u0027;\n  if (diffHours \u003e= 23 \u0026\u0026 diffHours \u003c= 25 \u0026\u0026 !reminderSent \u0026\u0026 rec.status === \u0027confirmed\u0027) {\n    action = \u0027remind\u0027;\n  } else if (diffHours \u003c -0.25 \u0026\u0026 rec.status === \u0027confirmed\u0027) {\n    action = \u0027noshow\u0027;\n  }\n\n  if (action !== \u0027skip\u0027) {\n    result.push({ json: { ...rec, action, new_no_show_count: noShowCount + 1 } });\n  }\n}\n\nreturn result;"
                                     }
                  },
