                                   ]
                  },
                  {
                      "parameters":  {
                                         "operation":  "search",
                                         "base":  {
                                                      "__rl":  true,
                                                      "mode":  "id",
                                                      "value":  "PLACEHOLDER_AIRTABLE_BASE_ID"
                                                  },
                                         "table":  {
                                                       "__rl":  true,
                                                       "mode":  "id",
                                                       "value":  "PLACEHOLDER_AIRTABLE_TABLE_ID"
                                                   },
                                         "filterByFormula":  "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI(\u0027filterByFormula\u0027, \u0027고객의 instagram_handle로 검색하는 Airtable 필터. 예: {instagram_handle}=\"@hong_gildong\"\u0027) }}",
                                         "returnAll":  false,
                                         "limit":  1,
                                         "options":  {

                                                     }
                                     },
                      "id":  "09648ce0-4eca-4d45-9e3e-a21cf68e72f2",
                      "name":  "Airtable 리드 조회",
                      "type":  "n8n-nodes-base.airtableTool",
                      "typeVersion":  2.2,
                      "position":  [
                                       704,
                                       336
                                   ]
                  },
                  {
                      "parameters":  {
                                         "description":  "Airtable instagram_leads 테이블에서 기존 리드의 status, contact_count, is_vip, notes를 업데이트합니다.",
                                         "jsCode":  "const d = JSON.parse(query);\nconst B = \u0027PLACEHOLDER_AIRTABLE_BASE_ID\u0027;\nconst T = \u0027PLACEHOLDER_AIRTABLE_TABLE_ID\u0027;\nconst K = \u0027PLACEHOLDER_AIRTABLE_API_KEY\u0027;\nconst authHdr = { Authorization: \u0027Bearer \u0027 + K };\nconst jsonHdr = { \u0027Content-Type\u0027: \u0027application/json\u0027, Authorization: \u0027Bearer \u0027 + K };\nconst formula = encodeURIComponent(\u0027{instagram_handle}=\"\u0027 + d.instagram_handle + \u0027\"\u0027);\nconst sr = await fetch(\u0027https://api.airtable.com/v0/\u0027 + B + \u0027/\u0027 + T + \u0027?filterByFormula=\u0027 + formula + \u0027\u0026maxRecords=1\u0027, { headers: authHdr });\nconst sd = await sr.json();\nconst ex = sd.records \u0026\u0026 sd.records[0];\nif (!ex) return \u0027리드 없음: \u0027 + d.instagram_handle;\nconst fields = {\n  status: d.status || ex.fields.status,\n  contact_count: typeof d.contact_count === \u0027number\u0027 ? d.contact_count : (ex.fields.contact_count || 1),\n  is_vip: typeof d.is_vip === \u0027boolean\u0027 ? d.is_vip : !!ex.fields.is_vip,\n  last_interaction: new Date().toISOString(),\n  notes: d.notes || ex.fields.notes || \u0027\u0027\n};\nconst wr = await fetch(\u0027https://api.airtable.com/v0/\u0027 + B + \u0027/\u0027 + T + \u0027/\u0027 + ex.id, {\n  method: \u0027PATCH\u0027,\n  headers: jsonHdr,\n  body: JSON.stringify({ fields: fields })\n});\nreturn \u0027리드 업데이트 완료: \u0027 + d.instagram_handle + \u0027 → status=\u0027 + fields.status;",
                                         "specifyInputSchema":  true,
                                         "jsonSchemaExample":  "{\"instagram_handle\":\"@hong_gildong\",\"status\":\"talking\",\"contact_count\":2,\"is_vip\":false,\"notes\":\"화요일 오후 2시 예약 문의\"}"
                                     },
                      "id":  "5924328a-b62e-4123-a45a-67381b032400",
                      "name":  "Airtable 리드 업데이트",
                      "type":  "@n8n/n8n-nodes-langchain.toolCode",
                      "typeVersion":  1.3,
                      "position":  [
                                       832,
                                       336
                                   ]
                  },
                  {
                      "parameters":  {
                                         "description":  "ManyChat API를 통해 고객에게 인스타그램 DM 답장을 발송합니다. subscriber_id와 message_text가 필요합니다.",
                                         "jsCode":  "const d = JSON.parse(query);\nconst r = await fetch(\u0027https://api.manychat.com/fb/sending/sendContent\u0027, {\n  method: \u0027POST\u0027,\n  headers: { \u0027Content-Type\u0027: \u0027application/json\u0027, Authorization: \u0027Bearer PLACEHOLDER_MANYCHAT_API_KEY\u0027 },\n  body: JSON.stringify({\n    subscriber_id: d.subscriber_id,\n    data: { version: \u0027v2\u0027, content: { messages: [{ type: \u0027text\u0027, text: d.message_text }] } }\n  })\n});\nconst res = await r.json();\nif (res.status !== \u0027success\u0027) return \u0027DM 발송 실패: \u0027 + JSON.stringify(res);\nreturn \u0027DM 답장 발송 완료: \u0027 + d.subscriber_id;",
                                         "specifyInputSchema":  true,
                                         "jsonSchemaExample":  "{\"subscriber_id\":\"MANYCHAT_SUB_ID\",\"message_text\":\"화요일 오후 2시, 4시 가능합니다!\"}"
                                     },
                      "id":  "1127e483-f6a1-4268-8ac9-8f655ccd4537",
                      "name":  "ManyChat DM 답장",
                      "type":  "@n8n/n8n-nodes-langchain.toolCode",
