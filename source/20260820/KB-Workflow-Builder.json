                                   ],
                      "parameters":  {
                                         "description":  "workflow_builder_usage 테이블의 usage_count를 1 증가시킨다. 이메일 발송 완료 후 마지막으로 호출. 입력: sessionId",
                                         "language":  "javaScript",
                                         "specifyInputSchema":  true,
                                         "schemaType":  "fromJson",
                                         "jsonSchemaExample":  "{\"sessionId\":\"user123\"}",
                                         "jsCode":  "const args = JSON.parse(query || \u0027{}\u0027);\nconst { sessionId = \u0027\u0027 } = args;\nif (!sessionId) return \u0027sessionId 누락\u0027;\nconst resp = await fetch(\u0027PLACEHOLDER_NEON_HTTP_URL/sql\u0027, {\n  method: \u0027POST\u0027,\n  headers: { \u0027Authorization\u0027: \u0027Bearer PLACEHOLDER_NEON_API_KEY\u0027, \u0027Content-Type\u0027: \u0027application/json\u0027 },\n  body: JSON.stringify({\n    query: \u0027INSERT INTO workflow_builder_usage (user_id, usage_count, last_used_at) VALUES ($1, 1, NOW()) ON CONFLICT (user_id) DO UPDATE SET usage_count = workflow_builder_usage.usage_count + 1, last_used_at = NOW() RETURNING usage_count\u0027,\n    params: [sessionId]\n  })\n});\nconst data = await resp.json();\nconst newCount = data.rows?.[0]?.usage_count ?? 1;\nreturn JSON.stringify({ success: true, newCount, remaining: Math.max(0, 3 - newCount) });"
                                     }
