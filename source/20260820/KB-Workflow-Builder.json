                                   ],
                      "parameters":  {
                                         "description":  "수집된 8개 항목(process_name, trigger, input_data, processing, output, tools, ai_needed, error_handling, sessionId, userEmail)을 받아 n8n 워크플로우 시나리오 md를 생성한다. 사용자가 \"확정\" 입력 후에만 호출.",
                                         "language":  "javaScript",
                                         "specifyInputSchema":  true,
                                         "schemaType":  "fromJson",
                                         "jsonSchemaExample":  "{\"process_name\":\"주문 처리 자동화\",\"trigger\":\"Webhook\",\"input_data\":\"Google Sheets\",\"processing\":\"분류 및 변환\",\"output\":\"Slack 알림\",\"tools\":\"Google Sheets, Slack\",\"ai_needed\":\"Yes - 분류\",\"error_handling\":\"Slack 알림\",\"sessionId\":\"user123\",\"userEmail\":\"user@example.com\"}",
                                         "jsCode":  "const args = JSON.parse(query || \u0027{}\u0027);\nconst { process_name=\u0027미정\u0027, trigger=\u0027\u0027, input_data=\u0027\u0027, processing=\u0027\u0027, output=\u0027\u0027, tools=\u0027\u0027, ai_needed=\u0027\u0027, error_handling=\u0027\u0027, sessionId=\u0027\u0027, userEmail=\u0027\u0027 } = args;\nconst today = new Date().toISOString().split(\u0027T\u0027)[0];\nconst safe = process_name.replace(/[\\s/\\\\:*?\"\u003c\u003e|]/g, \u0027_\u0027);\nconst filename = today + \u0027_\u0027 + safe + \u0027.md\u0027;\nconst lines = [\n  \u0027# 시나리오: \u0027 + process_name, \u0027\u0027,\n  \u0027## Context\u0027, \u0027\u0027,\n  process_name + \u0027 비즈니스 프로세스 자동화 워크플로우. kBusiness Workflow Builder 생성.\u0027, \u0027\u0027,\n  \u0027---\u0027, \u0027\u0027, \u0027## 트리거\u0027, \u0027\u0027, trigger, \u0027\u0027,\n  \u0027---\u0027, \u0027\u0027, \u0027## 입력 데이터\u0027, \u0027\u0027, input_data, \u0027\u0027,\n  \u0027---\u0027, \u0027\u0027, \u0027## 핵심 처리\u0027, \u0027\u0027, processing, \u0027\u0027,\n  \u0027---\u0027, \u0027\u0027, \u0027## 출력/저장\u0027, \u0027\u0027, output, \u0027\u0027,\n  \u0027---\u0027, \u0027\u0027, \u0027## 외부 연동\u0027, \u0027\u0027, tools, \u0027\u0027,\n  \u0027---\u0027, \u0027\u0027, \u0027## AI 사용 여부\u0027, \u0027\u0027, ai_needed, \u0027\u0027,\n  \u0027---\u0027, \u0027\u0027, \u0027## 에러/예외 처리\u0027, \u0027\u0027, error_handling, \u0027\u0027,\n  \u0027---\u0027, \u0027\u0027, \u0027## 생성 정보\u0027, \u0027\u0027,\n  \u0027- 생성일: \u0027 + today,\n  \u0027- 요청자: \u0027 + (userEmail || sessionId),\n  \u0027- 생성 도구: KB Workflow Builder (kBusiness.ca)\u0027\n];\nreturn JSON.stringify({ content: lines.join(\u0027\\n\u0027), filename, processName: process_name });"
                                     }
